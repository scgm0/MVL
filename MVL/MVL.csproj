<Project Sdk="Godot.NET.Sdk/4.8.0-beta">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <PublishAot>true</PublishAot>
        <UseNativeLibPrefix>false</UseNativeLibPrefix>
        <EnableSourceLink Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">false</EnableSourceLink>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>preview</LangVersion>
        <InvariantGlobalization>true</InvariantGlobalization>
        <OptimizationPreference>Size</OptimizationPreference>
        <InformationalVersion>1.1.0-dev</InformationalVersion>
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="GodotSharp" />
        <TrimmerRootAssembly Include="$(TargetName)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ComputerInfo" Version="0.2.0" />
        <PackageReference Include="CSemVer" Version="13.0.0" />
        <PackageReference Include="Flurl.Http" Version="4.0.2" />
        <PackageReference Include="InnoUnpack.NET" Version="1.0.4" />
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
        <PackageReference Include="Nerdbank.MessagePack" Version="1.5.70-alpha" />
        <PackageReference Include="NetMQ" Version="4.0.4.5" />
        <PackageReference Include="PublishAotCross.LinuxToWin" Version="1.0.0" />
        <PackageReference Include="ZLogger" Version="2.6.2" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../SharedLibrary/*.cs">
            <Link>Src/SharedLibrary/*.cs</Link>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Content Include="**/*.gd" />
        <Content Include="**/*.uid" DependentUpon="%(Filename)" />
        <Content Include="**/*.json" DependentUpon="%(Filename).cs" />
        <Content Include="**/*.txt" DependentUpon="%(Filename).cs" />
        <Compile Update="**/*.*.cs" DependentUpon="$([System.IO.Path]::GetFileNameWithoutExtension('%(Filename)')).cs" />
        <Content Remove=".godot\**" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Assets/Icon/MD/icons.json" />
        <AdditionalFiles Include="../AUTHORS.md" />
        <AdditionalFiles Include="../DONORS.md" />
        <AdditionalFiles Include="../LICENSE" />
        <AdditionalFiles Include="License/**/LICENSE.txt" />
        <AdditionalFiles Include="License/**/WEBSITE.txt" />
    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="InformationalVersion" />
        <CompilerVisibleProperty Include="AppCommitHash" />
        <CompilerVisibleProperty Include="AppBuildTime" />
        <ProjectReference Include="../MVLGenerator/MVLGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="PreBuild" BeforeTargets="Build">
        <RemoveDir Directories="Misc/VSRun" />

        <Exec Command="dotnet build &quot;../VSRun/VSRun.csproj&quot; /p:Configuration=Release /p:Platform=$(Platform) &quot;/p:VSRunBundleDir=$(MSBuildProjectDirectory)/Misc/VSRun&quot;" />
    </Target>

    <Target Name="SetBuildInfoProperties" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
        <Exec Command="git rev-parse HEAD" ConsoleToMsBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitShortHash" />
        </Exec>

        <PropertyGroup>
            <GitShortHash Condition="'$(GitShortHash)' == ''">LocalDev</GitShortHash>
            <AppCommitHash>$(GitShortHash)</AppCommitHash>
            <AppBuildTime>$([System.DateTimeOffset]::UtcNow)</AppBuildTime>
        </PropertyGroup>
    </Target>

    <Target Name="FixMsvcImportLibCase" BeforeTargets="LinkNative"
            Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win')) And !$([MSBuild]::IsOSPlatform('Windows'))">
        <PropertyGroup>
            <_MsvcBinDir Condition="'$(MSVCWineBinPath)' != ''">$(MSVCWineBinPath)</_MsvcBinDir>
            <_MsvcBinDir Condition="'$(_MsvcBinDir)' == ''">/opt/msvc/bin</_MsvcBinDir>
            <_MsvcSdkLibRoot>$([System.IO.Path]::GetFullPath('$(_MsvcBinDir)/../Windows Kits/10/Lib'))</_MsvcSdkLibRoot>
            <_WinTargetArch Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x64</_WinTargetArch>
            <_WinTargetArch Condition="$(RuntimeIdentifier.EndsWith('-x86'))">x86</_WinTargetArch>
            <_WinTargetArch Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</_WinTargetArch>
        </PropertyGroup>

        <ItemGroup>
            <_SynchronizationLib Include="$(_MsvcSdkLibRoot)/*/um/$(_WinTargetArch)/synchronization.lib" />
        </ItemGroup>

        <PropertyGroup>
            <_SynchronizationLibPath>@(_SynchronizationLib)</_SynchronizationLibPath>
        </PropertyGroup>

        <ItemGroup Condition="'$(_SynchronizationLibPath)' != ''">
            <LinkerArg Remove="&quot;Synchronization.lib&quot;" />
            <LinkerArg Include="&quot;$(_SynchronizationLibPath)&quot;" />
        </ItemGroup>

        <Message Importance="normal" Text="FixMsvcImportLibCase: Synchronization.lib -> $(_SynchronizationLibPath)" />
    </Target>
</Project>
